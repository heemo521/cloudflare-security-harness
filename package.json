{
  "name": "cloudflare-security-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A Cloudflare Workers security layer that fronts an origin and enforces a configurable chain of controls.",
  "license": "MIT",
  "keywords": [
    "cloudflare",
    "workers",
    "security",
    "waf",
    "rate-limiting",
    "cloudflare-access",
    "middleware"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
